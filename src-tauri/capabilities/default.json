{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "node", "cmd": "node", "args": ["-v"] },
        { "name": "javac", "cmd": "javac", "args": ["-version"] },
        { "name": "adb", "cmd": "adb", "args": ["--version"] },
        { "name": "ns", "cmd": "ns", "args": ["-v"] },
        { "name": "ns-cmd", "cmd": "ns.cmd", "args": ["-v"] },
        { "name": "xcode-select", "cmd": "xcode-select", "args": ["-p"] },
        { "name": "pod", "cmd": "pod", "args": ["--version"] },
        { "name": "brew", "cmd": "brew", "args": ["--version"] }
      ]
    },
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    },
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-resizable",
    "core:window:allow-set-maximizable",
    "core:window:allow-set-minimizable",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:app:allow-version",
    "core:app:allow-name"
  ]
}
